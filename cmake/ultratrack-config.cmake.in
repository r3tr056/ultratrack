@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenCV 4.5 REQUIRED)
find_dependency(Threads REQUIRED)
find_dependency(spdlog REQUIRED)
find_dependency(nlohmann_json REQUIRED)

if(@ULTRATRACK_WITH_ONNXRUNTIME@)
    find_dependency(OnnxRuntime REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ultratrack-targets.cmake")

check_required_components(ultratrack)
